{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "binhotti-gestao-preview",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
